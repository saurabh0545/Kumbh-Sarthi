# ==============================================================================
# Kumbh Smart Assist — Environment Configuration Template
# ==============================================================================

# Local Network Backend Configuration (FastAPI)
# Set this to your local Wi-Fi or hotspot IP address (port 8001)
EXPO_PUBLIC_API_URL=http://10.40.225.186:8001

# ==============================================================================
# FIREBASE CLOUD FIRESTORE CONFIGURATION (Real-Time App & Website Sync)
# Obtain your credentials from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==============================================================================
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
